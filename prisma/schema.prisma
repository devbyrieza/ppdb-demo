model PengajuanBeasiswa {
  id                    String    @id @default(uuid()) @db.Uuid
  pendaftar_id          String    @unique @db.Uuid
  tahun_ajaran_id       String    @db.Uuid
  jenis_pengajuan       String    // "BEASISWA_PRESTASI" | "KERINGANAN_BIAYA"
  alasan_pengajuan      String?   @db.Text
  nominal_kesanggupan   Decimal?  @db.Decimal
  
  file_sktm_path        String?
  file_slip_gaji_path   String?
  file_ktp_path         String?
  file_prestasi_path    String?
  diajukan_oleh_id      String?   @db.Uuid
  diajukan_oleh_role    String?
  
  status                String    @default("PENDING") // "PENDING" | "DISETUJUI" | "DITOLAK"
  
  disetujui_oleh        String?   @db.Uuid
  disetujui_pada        DateTime? @db.Timestamptz(6)
  catatan_keputusan     String?   @db.Text
  tipe_potongan         String?   // "NOMINAL" | "PERSENTASE"
  nominal_potongan      Decimal?  @db.Decimal
  persentase_potongan   Decimal?  @db.Decimal(5,2)

  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)

  pendaftar             Pendaftar @relation(fields: [pendaftar_id], references: [id], onDelete: Cascade)
  tahun_ajaran          TahunAjaran @relation(fields: [tahun_ajaran_id], references: [id])
  approver              Profile?  @relation("BeasiswaApprovedBy", fields: [disetujui_oleh], references: [id])

  @@map("pengajuan_beasiswa")
}
