model WhatsappLog {
  id              String     @id @default(uuid()) @db.Uuid
  pendaftar_id    String?    @db.Uuid
  phone           String
  jenis_notif     String
  status          String     @default("pending")
  response_data   String?
  attempt_count   Int        @default(0)
  max_attempts    Int        @default(3)
  scheduled_at    DateTime   @default(now()) @db.Timestamptz(6)
  sent_at         DateTime?  @db.Timestamptz(6)
  failed_at       DateTime?  @db.Timestamptz(6)
  error_message   String?
  message_content String?
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @default(now()) @db.Timestamptz(6)
  pendaftar       Pendaftar? @relation(fields: [pendaftar_id], references: [id])

  @@index([status, scheduled_at])
  @@index([pendaftar_id, jenis_notif])
  @@index([phone])
  @@map("whatsapp_log")
}

